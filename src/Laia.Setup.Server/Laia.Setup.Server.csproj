<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LAIA-Server-Setup</AssemblyName>
    <RootNamespace>Laia.Setup.Server</RootNamespace>
    <Product>LAIA Server Setup</Product>
    <ApplicationIcon>..\..\assets\laia.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Laia.Setup.Server.Program</StartupObject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Laia.Setup.Common\Laia.Setup.Common.csproj" />
    <ProjectReference Include="..\Laia.Common\Laia.Common.csproj" />
  </ItemGroup>
</Project>
