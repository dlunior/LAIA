<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Laia.Server</RootNamespace>
    <AssemblyName>Laia.Server</AssemblyName>
    <ApplicationIcon>..\..\assets\laia.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Laia.Common\Laia.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="wwwroot\map.html" LogicalName="map.html" />
    <EmbeddedResource Include="..\..\assets\logo.png" LogicalName="logo.png" Link="logo.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="wwwroot\**" />
  </ItemGroup>
</Project>
